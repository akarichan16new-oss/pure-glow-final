# ============================================================================
# PureGlow AI - Environment Variables
# ============================================================================
# 1. Copy this file:    cp .env.example .env
# 2. Edit values for your environment
# 3. NEVER commit .env to git (only .env.example)
# ============================================================================

# ── Application environment ──────────────────────────────────────────────────
# Choose one: development | testing | production
FLASK_ENV=development

# ── Server bind address ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: change this for production -- use a long random string.
# Generate one with:    python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-key-change-me-in-production

# ── Recommendation engine ────────────────────────────────────────────────────
# Load engine once at startup (true) or reload on every request (false).
# Use false during development if you edit model files often.
ENGINE_PRELOAD=true

# Default and maximum top_n values for /api/recommend
DEFAULT_TOP_N=5
MAX_TOP_N=100

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your React dev server and your production domain.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────────────
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Set to true to also write logs to logs/pureglow.log
LOG_TO_FILE=false

# ── Optional: override default paths ─────────────────────────────────────────
# Uncomment and edit only if your folders are not in the default locations.
# MODELS_DIR=/var/data/models
# SRC_DIR=/var/data/src

# ── Rate limiting (placeholder for future use) ───────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT=60 per minute
